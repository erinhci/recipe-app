{
  "name": "our-kitchen-motion",
  "private": true,
  "version": "0.1.0",
  "description": "Headless renderer: plays an HTML scene frame by frame in Chromium and writes an MP4.",
  "type": "module",
  "bin": {
    "render-motion": "./render.mjs"
  },
  "scripts": {
    "render": "node render.mjs",
    "example": "node render.mjs examples/next-step.html --out out/next-step.mp4",
    "test": "node test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "1.64.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
