# Copy to .env.local for local development. In Vercel, add these as
# Environment Variables instead. Both values are on the Supabase project's
# API settings page. Never put the service_role key or database password here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
